<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector=".dfm-ui CheckBox">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="15,*">
          <Border Width="12" Height="12" BorderBrush="#777777" BorderThickness="1"
                  Background="White" CornerRadius="1" HorizontalAlignment="Left"
                  VerticalAlignment="Center">
            <TextBlock Text="✓" FontSize="11" Foreground="#006CC8"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{TemplateBinding IsChecked}" />
          </Border>
          <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}"
                            VerticalAlignment="Center" RecognizesAccessKey="True" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector=".dfm-ui RadioButton">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="16,*">
          <Border Width="12" Height="12" BorderBrush="#777777" BorderThickness="1"
                  Background="White" CornerRadius="6" HorizontalAlignment="Left"
                  VerticalAlignment="Center">
            <Ellipse Width="6" Height="6" Fill="#006CC8"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsVisible="{TemplateBinding IsChecked}" />
          </Border>
          <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}"
                            VerticalAlignment="Center" RecognizesAccessKey="True" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector=".dfm-ui CheckBox:disabled, .dfm-ui RadioButton:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>
  <Style Selector=".dfm-ui CheckBox:focus-visible, .dfm-ui RadioButton:focus-visible">
    <Setter Property="Background" Value="#D8E9FA" />
  </Style>

  <Style Selector=".dfm-ui ScrollBar:horizontal">
    <Setter Property="AllowAutoHide" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="14,*,14" Background="#E5E5E5">
          <RepeatButton Name="PART_LineUpButton" Content="&lt;" Padding="0" MinWidth="0" MinHeight="0" FontSize="9" />
          <Track Name="PART_Track" Grid.Column="1" Orientation="{TemplateBinding Orientation}"
                 Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value, Mode=TwoWay}" ViewportSize="{TemplateBinding ViewportSize}"
                 IsDirectionReversed="False">
            <Track.DecreaseButton><RepeatButton Name="PART_PageUpButton" Background="Transparent" BorderThickness="0" Padding="0" MinWidth="0" MinHeight="0" /></Track.DecreaseButton>
            <Track.Thumb><Thumb Name="PART_Thumb" Width="14" Height="12" Background="#BFC3C7"><Thumb.Template><ControlTemplate><Border Background="{TemplateBinding Background}" BorderBrush="#777777" BorderThickness="1" CornerRadius="1" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
            <Track.IncreaseButton><RepeatButton Name="PART_PageDownButton" Background="Transparent" BorderThickness="0" Padding="0" MinWidth="0" MinHeight="0" /></Track.IncreaseButton>
          </Track>
          <RepeatButton Name="PART_LineDownButton" Grid.Column="2" Content="&gt;" Padding="0" MinWidth="0" MinHeight="0" FontSize="9" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector=".dfm-ui ScrollBar:vertical">
    <Setter Property="AllowAutoHide" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid RowDefinitions="14,*,14" Background="#E5E5E5">
          <RepeatButton Name="PART_LineUpButton" Content="^" Padding="0" MinWidth="0" MinHeight="0" FontSize="9" />
          <Track Name="PART_Track" Grid.Row="1" Orientation="{TemplateBinding Orientation}"
                 Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value, Mode=TwoWay}" ViewportSize="{TemplateBinding ViewportSize}"
                 IsDirectionReversed="True">
            <Track.DecreaseButton><RepeatButton Name="PART_PageUpButton" Background="Transparent" BorderThickness="0" Padding="0" MinWidth="0" MinHeight="0" /></Track.DecreaseButton>
            <Track.Thumb><Thumb Name="PART_Thumb" Width="12" Height="14" Background="#BFC3C7"><Thumb.Template><ControlTemplate><Border Background="{TemplateBinding Background}" BorderBrush="#777777" BorderThickness="1" CornerRadius="1" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
            <Track.IncreaseButton><RepeatButton Name="PART_PageDownButton" Background="Transparent" BorderThickness="0" Padding="0" MinWidth="0" MinHeight="0" /></Track.IncreaseButton>
          </Track>
          <RepeatButton Name="PART_LineDownButton" Grid.Row="2" Content="v" Padding="0" MinWidth="0" MinHeight="0" FontSize="9" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector=".dfm-ui Slider">
    <Setter Property="Template">
      <ControlTemplate>
        <Grid>
          <Border Name="TrackLine" Height="2" Background="#999999" VerticalAlignment="Center" />
          <Track Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value, Mode=TwoWay}" Orientation="{TemplateBinding Orientation}"
                 IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
            <Track.DecreaseButton><RepeatButton Name="PART_DecreaseButton" Background="Transparent" BorderThickness="0" Padding="0" MinWidth="0" MinHeight="0" /></Track.DecreaseButton>
            <Track.Thumb><Thumb Name="PART_Thumb" Width="10" Height="12" Background="#BFC3C7"><Thumb.Template><ControlTemplate><Border Background="{TemplateBinding Background}" BorderBrush="#777777" BorderThickness="1" CornerRadius="1" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
            <Track.IncreaseButton><RepeatButton Name="PART_IncreaseButton" Background="Transparent" BorderThickness="0" Padding="0" MinWidth="0" MinHeight="0" /></Track.IncreaseButton>
          </Track>
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector=".dfm-ui Slider:vertical /template/ Border#TrackLine">
    <Setter Property="Width" Value="2" /><Setter Property="Height" Value="NaN" />
    <Setter Property="VerticalAlignment" Value="Stretch" /><Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector=".dfm-ui Slider:vertical /template/ Thumb#PART_Thumb">
    <Setter Property="Width" Value="12" /><Setter Property="Height" Value="10" />
  </Style>
  <Style Selector=".dfm-ui TabItem">
    <Setter Property="Padding" Value="8,1" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="#999999" BorderThickness="1,1,1,0">
          <ContentPresenter Name="PART_HeaderPresenter" Content="{TemplateBinding Header}"
                            ContentTemplate="{TemplateBinding HeaderTemplate}" Padding="{TemplateBinding Padding}"
                            RecognizesAccessKey="True" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector=".dfm-ui TabItem:selected">
    <Setter Property="Background" Value="#F0F0F0" />
  </Style>
  <Style Selector=".dfm-ui TabStripItem">
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="#999999" BorderThickness="1,1,1,0">
          <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}"
                            RecognizesAccessKey="True" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector=".dfm-ui TabStripItem:selected">
    <Setter Property="Background" Value="#F0F0F0" />
  </Style>
</Styles>

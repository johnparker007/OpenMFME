<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpenMFME.Desktop.MainWindow"
        Title="OpenMFME" Width="1120" Height="760" MinWidth="480" MinHeight="320">
  <Grid RowDefinitions="Auto,Auto,*">
    <Menu x:Name="MainMenuBar" Grid.Row="0" />
    <ScrollViewer x:Name="MeterStrip" Grid.Row="1"
                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                  Background="#F0F0F0" />
    <Border x:Name="LayoutHost" Grid.Row="2" Background="White" ClipToBounds="True" />
  </Grid>
</Window>
